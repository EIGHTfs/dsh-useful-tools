{
  "name": "dsh-useful-tools",
  "version": "0.1.33",
  "description": "DSH 有用小工具箱：命令读文件自动算已读（mark_read）+ 编辑后标记免重读（mark_edit）+ 快捷命令（quick_command）+ 插件同步（sync_plugin）+ 后端模拟（minihost）+ 前端预览（preview）+ UI 静态骨架检查（ui_check）+ 插件验证（verify_plugin）+ 测试环境（test_env）+ GitHub 代理安装（github_mirror）+ 工具清单（useful_tools）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node test/run-tests.mjs"
  },
  "license": "MIT",
  "author": "EIGHTfs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EIGHTfs/dsh-useful-tools.git"
  },
  "bugs": {
    "url": "https://github.com/EIGHTfs/dsh-useful-tools/issues"
  },
  "homepage": "https://github.com/EIGHTfs/dsh-useful-tools#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mark-read",
    "plugin-sync",
    "minihost",
    "preview",
    "test-env"
  ]
}
