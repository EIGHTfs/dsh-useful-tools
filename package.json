{
  "name": "dsh-useful-tools",
  "version": "0.1.20",
  "description": "DSH 有用小工具箱：命令读文件自动算已读（mark_read）+ 插件同步（sync_plugin）+ 后端模拟（minihost）+ 前端预览（preview）+ 插件验证（verify_plugin）+ 测试环境（test_env）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "test",
    "docs",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "license": "MIT",
  "author": "EIGHTfs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EIGHTfs/dsh-useful-tools.git"
  },
  "bugs": {
    "url": "https://github.com/EIGHTfs/dsh-useful-tools/issues"
  },
  "homepage": "https://github.com/EIGHTfs/dsh-useful-tools#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "mark-read",
    "plugin-sync",
    "minihost",
    "preview",
    "test-env"
  ]
}
